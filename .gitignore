year_2025.csv
state_FL-*.csv
*.hmda-raw.csv

# Optional local caches / extracts (regenerated by scripts)
data/hmda/florida/_our_lenders_extract.json

# National lender×county file can exceed GitHub soft limits — keep local if huge
# (smaller national tables + by-state partitions are committed)
data/hmda/national/lender_activity_by_county.csv

# FL-LEND-002F transformed source material and execution reports are local-only.
data/generated/fl-lend-002f/
__pycache__/
*.pyc

# NJ-LEND-001 raw DOBI HTML/PDF corpus — never commit large acquisitions
data/raw/nj_dobi/
data/generated/nj-lend-001/occurrences.json
data/generated/nj-lend-001/events.json
data/generated/nj-lend-001/identity-ledgers.json
